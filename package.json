    "lint-staged": "^11.2.6",
    "moment": "^2.30.1",
    "obsidian": "^1.11.0",
    "prettier": "^2.8.8",
    "prettier-plugin-svelte": "^2.10.1",
    "rimraf": "^3.0.2",
    "svelte": "^3.59.2",
    "svelte-check": "^1.6.0",
    "svelte-preprocess": "^4.10.7",
    "ts-jest": "^29.4.6",
