{
  "extends": "@tsconfig/svelte/tsconfig.json",

  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules/*"],
  "compilerOptions": {
    "types": ["node", "svelte", "jest", "electron"],
    "baseUrl": ".",
    "paths": {
      "src": ["src/*", "tests/*"],
      "~/*": ["src/*"]
    },
    "resolveJsonModule": true
  }
}
